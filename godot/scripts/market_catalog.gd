static func all() -> Array:
    return ENTRIES

static func find(id: String) -> Dictionary:
    for entry in ENTRIES:
        if entry["id"] == id:
            return entry
    return {}

static func find_by_name(model_name: String) -> Dictionary:
    for entry in ENTRIES:
        if entry["name"] == model_name:
            return entry
    return {}

# Reference price (ARS) of a unit of typical age, mileage and condition.
static func reference_ars(entry: Dictionary) -> float:
    return sqrt(float(entry["price_min"]) * float(entry["price_max"]))
