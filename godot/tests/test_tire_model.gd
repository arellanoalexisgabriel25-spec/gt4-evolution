extends SceneTree

const Tire = preload("res://scripts/tire_model.gd")
var checks := 0
var failed := false

func check(ok: bool, message: String) -> void:
    checks += 1
    if not ok:
        failed = true
        push_error(message)

func drive(tire, seconds: float, demand: float, speed: float, hz: int = 60, road: bool = true) -> void:
    for i in range(roundi(seconds * hz)):
        tire.step(1.0 / hz, demand, speed, road)

func _initialize() -> void:
    var cold = Tire.new()
    check(is_equal_approx(cold.temperature, Tire.AMBIENT) and cold.wear == 0.0, "New tires start cold and unworn")
    check(cold.grip_multiplier() > 0.90 and cold.grip_multiplier()<1.0, "Road tires retain usable grip from ambient temperature")
    drive(cold, 40.0, 0.4, 20.0)
    check(cold.temperature > 35.0 and cold.temperature < 55.0, "Moderate road-tire use approaches its working range")
    check(cold.grip_multiplier() > 0.97, "Warm tires give full grip")
    var idle = Tire.new()
    drive(idle, 300.0, 0.0, 0.0)
    check(is_equal_approx(idle.temperature, Tire.AMBIENT), "Unused tires stay at ambient temperature")
    var hot = Tire.new()
    drive(hot, 60.0, 1.2, 20.0)
    check(hot.temperature > 150.0 and hot.temperature <= Tire.MAX_TEMPERATURE, "Abuse overheats tires within the physical cap")
    check(hot.grip_multiplier() < cold.grip_multiplier() - 0.2, "Overheated and worn tires lose grip")
    var a = Tire.new()
    var b = Tire.new()
    drive(a, 30.0, 0.6, 20.0, 60)
    drive(b, 30.0, 0.6, 20.0, 120)
    check(absf(a.temperature - b.temperature) < 0.01 and absf(a.wear - b.wear) < 0.0001, "Results do not depend on tick rate")
    var road = Tire.new()
    var grass = Tire.new()
    drive(road, 30.0, 0.6, 20.0, 60, true)
    drive(grass, 30.0, 0.6, 20.0, 60, false)
    check(grass.wear > road.wear * 1.9, "Driving off-road wears tires faster")
    var gentle = Tire.new()
    var hard = Tire.new()
    drive(gentle, 120.0, 0.4, 20.0)
    drive(hard, 120.0, 0.9, 20.0)
    check(hard.wear > gentle.wear * 2.0, "Harder driving wears tires faster")
    var worn = Tire.new()
    worn.wear = 1.0
    worn.temperature = 80.0
    check(worn.grip_multiplier() < 0.75 and worn.grip_multiplier() >= 0.3, "Fully worn tires keep bounded reduced grip")
    var street = Tire.new("street")
    var sport = Tire.new("sport")
    drive(street, 40.0, 0.6, 20.0)
    drive(sport, 40.0, 0.6, 20.0)
    check(sport.grip_multiplier() > street.grip_multiplier() and sport.wear > street.wear, "Sport compound grips more and wears faster")
    check(Tire.new("nonsense").compound == "street", "Unknown compound falls back to street")
    var before: float = street.temperature
    street.step(0.0, 1.0, 20.0)
    street.step(NAN, 1.0, 20.0)
    street.step(1.0 / 60.0, NAN, 20.0)
    check(street.temperature == before, "Invalid inputs are ignored")
    check(is_equal_approx(Tire.demand_from(9.81, 1.0), 1.0) and Tire.demand_from(NAN, 1.0) == 0.0, "Demand is acceleration relative to available grip")
    var fresh = Tire.new()
    check(fresh.severity() == 1.0 and fresh.mean_demand() == 0.0, "Without data severity is neutral")
    var calm = Tire.new()
    var violent = Tire.new()
    drive(calm, 60.0, 0.4, 20.0)
    drive(violent, 60.0, 0.9, 20.0)
    check(is_equal_approx(calm.mean_demand(), 0.4) and is_equal_approx(violent.mean_demand(), 0.9), "Mean demand averages over time")
    check(calm.severity() > 0.9 and calm.severity() < 1.3 and violent.severity() > calm.severity() * 2.0, "Hard sessions wear the car much faster than calm ones")
    var coasting = Tire.new()
    drive(coasting, 30.0, 0.0, 20.0)
    check(coasting.severity() == 0.6, "Coasting still wears the car, but less")
    var shredding = Tire.new("sport")
    drive(shredding, 30.0, 2.0, 20.0)
    check(shredding.severity() == 5.0, "Severity is capped to the economy range")
    var warmed = Tire.new("sport")
    drive(warmed, 40.0, 0.6, 20.0)
    var cooler = Tire.new("street")
    drive(cooler, 40.0, 0.6, 20.0)
    check(warmed.severity() > cooler.severity(), "Sport compound raises severity")
    var rate_a = Tire.new()
    var rate_b = Tire.new()
    drive(rate_a, 30.0, 0.6, 20.0, 60)
    drive(rate_b, 30.0, 0.6, 20.0, 120)
    check(absf(rate_a.severity() - rate_b.severity()) < 0.001, "Severity does not depend on tick rate")
    var slick = Tire.new("slick")
    slick.burnout(3.0)
    var street_burn = Tire.new()
    street_burn.burnout(3.0)
    check(slick.grip_multiplier() > 1.2 and slick.grip_multiplier() > street_burn.grip_multiplier() * 1.2, "A warmed slick out-grips a street tire by more than 20 percent")
    check(Tire.new("slick").grip_multiplier() < 0.9, "Cold slicks have poor grip")
    var slick_use = Tire.new("slick")
    var street_use = Tire.new()
    drive(slick_use, 40.0, 0.6, 20.0)
    drive(street_use, 40.0, 0.6, 20.0)
    check(slick_use.wear > street_use.wear * 3.0 and slick_use.severity() > street_use.severity() * 1.5, "Slicks wear much faster than street tires")
    var burned = Tire.new()
    burned.burnout(3.0)
    check(burned.temperature > 60.0 and burned.temperature < 80.0 and burned.wear > 0.0 and burned.wear < 0.01, "A short burnout warms the tires with little wear")
    var ignored = Tire.new()
    ignored.burnout(NAN)
    ignored.burnout(-2.0)
    check(ignored.temperature == Tire.AMBIENT and ignored.elapsed == 0.0, "Invalid burnout lengths are ignored")
    var long_burn = Tire.new()
    long_burn.burnout(100.0)
    check(long_burn.elapsed <= 8.0001 and long_burn.temperature <= Tire.MAX_TEMPERATURE, "Burnouts are capped")
    var saved: Dictionary = sport.to_dict()
    var json = JSON.new()
    check(json.parse(JSON.stringify(saved)) == OK, "Tire state serializes to JSON")
    var restored = Tire.new()
    restored.elapsed = 5.0
    check(restored.restore(json.data) and restored.compound == "sport" and is_equal_approx(restored.wear, sport.wear), "Tire state restores from JSON")
    check(restored.elapsed == 0.0 and restored.severity() == 1.0, "Restoring starts a new session average")
    var intact = Tire.new()
    check(not intact.restore({"compound": "sport", "temperature": NAN, "wear": 0.1}) and intact.compound == "street", "Non-finite state rejected without changes")
    check(not intact.restore({"compound": "nonsense", "temperature": 50.0, "wear": 0.1}) and not intact.restore({"compound": "street", "temperature": 50.0, "wear": 2.0}) and not intact.restore({}), "Unknown compound, bad wear and empty data rejected")
    if failed:
        quit(1)
    else:
        print("PASS: %d tire model assertions" % checks)
        quit(0)
